{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "include": [
    "env.d.ts",
    "src/**/*",
    "src/**/*.vue",
    "auto-imports.d.ts",
    "components.d.ts",
    "../server/src/**/*.d.ts",
    "uno.config.ts"
  ],
  "exclude": [
    "src/**/__tests__/*"
  ],
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    // 本项目会按模块以 import type 引入 @server/* 类型, 需要让被引入的服务端源码能解析到其依赖的环境类型
    // (@types/koa-bodyparser 为 ctx.request.body 提供类型, 它属于 packages/server 的 devDependencies)
    "typeRoots": [
      "./node_modules/@types",
      "../server/node_modules/@types"
    ],
    "types": [
      "koa-bodyparser"
    ],
    "jsx": "preserve",
    "jsxImportSource": "vue",
    "lib": [
      "ESNext",
      "DOM",
      "DOM.Iterable"
    ],
    "skipLibCheck": true,
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@server/*": [
        "../server/src/*"
      ],
      "@common/*": [
        "../common/src/*"
      ],
      // inkline 通过链接引入, 其声明文件会从自身依赖目录解析 tiptap;
      // 统一映射到本项目安装的副本, 避免同名私有字段被判定为两份实现
      "@tiptap/core": [
        "./node_modules/@tiptap/core/dist/index.d.ts"
      ],
      "@tiptap/pm/model": [
        "./node_modules/@tiptap/pm/dist/model/index.d.ts"
      ],
      "@tiptap/pm/state": [
        "./node_modules/@tiptap/pm/dist/state/index.d.ts"
      ],
      "@tiptap/pm/view": [
        "./node_modules/@tiptap/pm/dist/view/index.d.ts"
      ]
    }
  }
}